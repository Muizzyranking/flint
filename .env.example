# Copy to .env for local development.
# Flint deployment mode (affects log verbosity/behavior)
APP_ENV=development

# Compose profiles to activate automatically. `mailhog` starts the local
# SMTP catcher for development. When switching to a real SMTP relay,
# remove `mailhog` here and point SMTP_HOST/SMTP_PORT/SMTP_FROM at it.
# (docker compose reads COMPOSE_PROFILES from .env.)
COMPOSE_PROFILES=mailhog
DEBUG=false

# API
API_KEY=dev-api-key
# Optional extra rotating keys, comma separated.
API_KEYS=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

# Database / Redis (host-run processes; docker-compose overrides hosts)
DATABASE_URL=postgresql+asyncpg://flint:flint@localhost:5432/flint
REDIS_URL=redis://localhost:6379/0

# SMTP (Mailhog in compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=flint@flint.local

# Worker
WORKER_CONCURRENCY=2
WORKER_BATCH_SIZE=25
# Empty = all registered handlers. Example: send_email,webhook_delivery
WORKER_HANDLERS=
WORKER_POLL_INTERVAL=0.5
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL=15
WORKER_SHUTDOWN_TIMEOUT=30
JOB_TIMEOUT_SECONDS=300

# Frontend dashboard (optional; started with: docker compose --profile frontend up)
# Defaults to the latest CI artifact of the official frontend (flint-ui).
# Override FRONTEND_RELEASE_URL with a pinned-version artifact URL if wanted.
# FRONTEND_REPO - git repository URL for the dev profile (--profile
# frontend-dev), which clones it and runs pnpm install + dev server.
FRONTEND_RELEASE_URL=
FRONTEND_REPO=

# Maintenance / aging (aging runs on the maintenance cadence)
MAINTENANCE_INTERVAL=15

# Limits / logging
MAX_PAYLOAD_BYTES=262144
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/flint.log
